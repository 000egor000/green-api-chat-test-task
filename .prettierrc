{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^\\.\\./(?!.*\\.css$)",
    "^\\./(?!.*\\.css$)",
    "",
    "\\.css$"
  ],
  "importOrderTypeScriptVersion": "5.6.3"
}
